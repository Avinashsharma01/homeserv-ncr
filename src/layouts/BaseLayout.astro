---
/**
 * BaseLayout.astro — Main site layout
 * Zero client JS, pure HTML+CSS shell inspired by Zukho's architecture
 */
import "../styles/global.css";
import { Home, PlusCircle } from "lucide-astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class={className}>
    <!-- Header -->
    <header class="bg-surface border-b border-line sticky top-0 z-50">
      <div
        class="max-w-7xl mx-auto px-4 flex items-center justify-between h-16"
      >
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 no-underline group">
          <div
            class="w-9 h-9 rounded-xl bg-brand-50 text-brand flex items-center justify-center group-hover:bg-brand group-hover:text-white transition-colors"
          >
            <Home size={20} />
          </div>
          <div class="leading-tight">
            <span class="text-lg font-bold text-brand">HomeServ</span>
            <span class="text-xs text-muted block -mt-1 font-medium"
              >Delhi NCR</span
            >
          </div>
        </a>

        <!-- Navigation -->
        <nav class="flex items-center gap-1 sm:gap-2" aria-label="Main">
          <a
            href="/"
            class="hidden sm:inline-flex px-3 py-2 text-sm font-medium text-ink hover:text-brand rounded-md hover:bg-brand-50 transition-colors"
            >Home</a
          >
          <a
            href="/#cities"
            class="hidden sm:inline-flex px-3 py-2 text-sm font-medium text-ink hover:text-brand rounded-md hover:bg-brand-50 transition-colors"
            >Cities</a
          >
          <a
            href="/#services"
            class="hidden sm:inline-flex px-3 py-2 text-sm font-medium text-ink hover:text-brand rounded-md hover:bg-brand-50 transition-colors"
            >Services</a
          >
          <a
            href="/post-your-ad"
            class="btn-primary text-sm py-2! px-4! flex items-center gap-1.5"
          >
            <PlusCircle size={15} /> Post Free Ad
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 py-6 min-h-[60vh]">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-ink text-white mt-auto">
      <div class="max-w-7xl mx-auto px-4 py-12">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Brand -->
          <div>
            <div class="flex items-center gap-2.5 mb-4">
              <div
                class="w-8 h-8 rounded-lg bg-white/10 text-brand-light flex items-center justify-center"
              >
                <Home size={18} />
              </div>
              <span class="text-lg font-bold">HomeServ NCR</span>
            </div>
            <p class="text-sm text-gray-400 leading-relaxed">
              Delhi NCR's most trusted directory for verified home service
              professionals. Find plumbers, electricians, AC technicians, and
              more near you.
            </p>
          </div>

          <!-- Quick Links -->
          <div>
            <h4 class="font-semibold mb-3 text-white">Quick Links</h4>
            <ul class="space-y-2 text-sm text-gray-400">
              <li>
                <a href="/" class="hover:text-white transition-colors">Home</a>
              </li>
              <li>
                <a
                  href="/post-your-ad"
                  class="hover:text-white transition-colors">Post Free Ad</a>
              </li>
              <li>
                <a href="/about" class="hover:text-white transition-colors"
                  >About Us</a>
              </li>
              <li>
                <a href="/contact" class="hover:text-white transition-colors"
                  >Contact Us</a>
              </li>
            </ul>
          </div>

          <!-- Top Cities -->
          <div>
            <h4 class="font-semibold mb-3 text-white">Top Cities</h4>
            <ul class="space-y-2 text-sm text-gray-400">
              <li>
                <a href="/delhi/" class="hover:text-white transition-colors"
                  >Delhi</a>
              </li>
              <li>
                <a href="/gurgaon/" class="hover:text-white transition-colors"
                  >Gurgaon</a>
              </li>
              <li>
                <a href="/noida/" class="hover:text-white transition-colors"
                  >Noida & Greater Noida</a>
              </li>
              <li>
                <a href="/faridabad/" class="hover:text-white transition-colors"
                  >Faridabad</a>
              </li>
              <li>
                <a href="/ghaziabad/" class="hover:text-white transition-colors"
                  >Ghaziabad</a>
              </li>
              <li>
                <a href="/meerut/" class="hover:text-white transition-colors"
                  >Meerut</a>
              </li>
              <li>
                <a href="/sonipat/" class="hover:text-white transition-colors"
                  >Sonipat</a>
              </li>
              <li>
                <a href="/panipat/" class="hover:text-white transition-colors"
                  >Panipat</a>
              </li>
            </ul>
          </div>

          <!-- Services -->
          <div>
            <h4 class="font-semibold mb-3 text-white">Services</h4>
            <ul class="space-y-2 text-sm text-gray-400">
              <li>
                <a
                  href="/search?category=plumber"
                  class="hover:text-white transition-colors">Plumber</a>
              </li>
              <li>
                <a
                  href="/search?category=electrician"
                  class="hover:text-white transition-colors">Electrician</a>
              </li>
              <li>
                <a
                  href="/search?category=ac-repair"
                  class="hover:text-white transition-colors">AC Repair</a>
              </li>
              <li>
                <a
                  href="/search?category=movers-packers"
                  class="hover:text-white transition-colors"
                  >Movers & Packers</a>
              </li>
              <li>
                <a
                  href="/search?category=painter"
                  class="hover:text-white transition-colors">Painter</a>
              </li>
            </ul>
          </div>
        </div>

        <div
          class="border-t border-gray-700 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4"
        >
          <p class="text-sm text-gray-500">
            &copy; 2026 HomeServ NCR. All Rights Reserved.
          </p>
          <div class="flex gap-6 text-sm text-gray-500">
            <a href="/privacy-policy" class="hover:text-white transition-colors"
              >Privacy Policy</a
            >
            <a href="/terms" class="hover:text-white transition-colors">Terms</a
            >
            <a
              href="/sitemap-index.xml"
              class="hover:text-white transition-colors">Sitemap</a
            >
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
