---
/**
 * [region]/[locality]/index.astro — Hyperlocal locality page
 * This is the core pSEO workhorse — one page per neighborhood across Delhi-NCR
 * Targets long-tail queries like "plumber in Hauz Khas Delhi"
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SEOHead from "../../../components/SEOHead.astro";
import ListingCard from "../../../components/ListingCard.astro";
import CategoryIcon from "../../../components/CategoryIcon.astro";
import { regions, type Region, type Locality } from "../../../data/regions";
import { categories, getCategoryBySlug } from "../../../data/categories";
import { getListings } from "../../../data/listings";
import { MapPin, Search } from "lucide-astro";

export function getStaticPaths() {
  const paths: {
    params: { region: string; locality: string };
    props: { region: Region; locality: Locality };
  }[] = [];

  for (const region of regions) {
    for (const locality of region.localities) {
      paths.push({
        params: { region: region.slug, locality: locality.slug },
        props: { region, locality },
      });
    }
  }
  return paths;
}

interface Props {
  region: Region;
  locality: Locality;
}

const { region, locality } = Astro.props;
const localListings = getListings({ region: region.slug, locality: locality.slug });

const faqItems = [
  {
    question: `How to find a reliable plumber in ${locality.name}, ${region.name}?`,
    answer: `Browse our verified plumber listings for ${locality.name}. Each provider has ratings, reviews, and direct contact. Look for the "Verified" badge for extra assurance.`,
  },
  {
    question: `What is the cost of AC repair in ${locality.name}?`,
    answer: `AC service costs in ${locality.name} typically range from ₹500 to ₹3,500 depending on the type of service (gas refill, deep cleaning, installation). Compare prices across our listed providers.`,
  },
  {
    question: `Are emergency home services available in ${locality.name}?`,
    answer: `Yes! Providers marked "24/7 Available" offer emergency plumbing, electrical, and AC repair services round the clock in ${locality.name}, ${region.name}.`,
  },
];

// Nearby localities from the same region (for internal linking)
const nearbyLocalities = region.localities
  .filter((l) => l.slug !== locality.slug)
  .slice(0, 8);
---

<BaseLayout>
  <SEOHead
    slot="head"
    title={`Home Services in ${locality.name}, ${region.name} — Plumber, Electrician, AC Repair | HomeServ NCR`}
    description={`Find verified home service professionals in ${locality.name}, ${region.name}. Trusted plumbers, electricians, AC repair, carpenters, movers & packers near you. Direct call & WhatsApp. PIN: ${locality.pinCodes[0]}`}
    canonicalPath={`/${region.slug}/${locality.slug}/`}
    breadcrumbs={[
      { name: "Home", url: "/" },
      { name: region.name, url: `/${region.slug}/` },
      { name: locality.name, url: `/${region.slug}/${locality.slug}/` },
    ]}
    faqItems={faqItems}
    localBusiness={{
      name: `HomeServ NCR — ${locality.name}`,
      areaServed: `${locality.name}, ${region.name}`,
      lat: locality.lat,
      lng: locality.lng,
      postalCode: locality.pinCodes[0],
    }}
  />

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="mb-4">
    <ol class="flex items-center gap-1 text-sm text-muted flex-wrap">
      <li><a href="/" class="hover:text-brand no-underline">Home</a></li>
      <li class="before:content-['/'] before:mx-1"><a href={`/${region.slug}/`} class="hover:text-brand no-underline">{region.name}</a></li>
      <li class="before:content-['/'] before:mx-1 font-medium text-ink">{locality.name}</li>
    </ol>
  </nav>

  <!-- Locality Hero -->
  <section class="mb-8">
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink mb-3">
      Home Services in <span class="text-brand">{locality.name}</span>, {region.name}
    </h1>
    <p class="text-muted text-lg leading-relaxed max-w-3xl">
      Find verified plumbers, electricians, AC repair technicians, carpenters, painters, and more in {locality.name}. Direct contact with local professionals — no middlemen, no advance payment required.
    </p>
    <p class="text-sm text-muted mt-2 flex items-center gap-1.5">
      <MapPin size={15} class="text-brand shrink-0" />
      <span>PIN Code: {locality.pinCodes.join(", ")}</span>
    </p>
  </section>

  <!-- Service Category Chips -->
  <section class="mb-8">
    <h2 class="text-lg font-bold text-ink mb-3">Services Available in {locality.name}</h2>
    <div class="flex flex-wrap gap-2">
      {categories.map((cat) => (
        <a
          href={`/search?region=${region.slug}&category=${cat.slug}&q=${locality.slug}`}
          class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-surface border border-line rounded-full text-sm font-medium text-ink hover:border-brand hover:text-brand transition-colors no-underline shadow-xs"
        >
          <CategoryIcon category={cat.slug} size={15} />
          <span>{cat.name}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Listings -->
  {localListings.length > 0 ? (
    <section class="mb-8">
      <h2 class="text-xl font-bold text-ink mb-4">
        Service Providers in {locality.name}
      </h2>
      <p class="text-sm text-muted mb-4">{localListings.length} result(s) found</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {localListings.map((listing) => (
          <ListingCard
            id={listing.id}
            slug={listing.slug}
            title={listing.title}
            category={listing.category}
            locality={listing.locality}
            region={listing.region}
            providerName={listing.providerName}
            description={listing.description}
            rating={listing.rating}
            reviewCount={listing.reviewCount}
            price={listing.price}
            experience={listing.experience}
            verified={listing.verified}
            premium={listing.premium}
            available24x7={listing.available24x7}
            phone={listing.phone}
            whatsapp={listing.whatsapp}
          />
        ))}
      </div>
    </section>
  ) : (
    <section class="mb-8 text-center py-12">
      <div class="w-16 h-16 mx-auto rounded-full bg-gray-100 flex items-center justify-center text-gray-400 mb-4">
        <Search size={32} />
      </div>
      <h2 class="text-xl font-bold text-ink mb-2">No listings yet in {locality.name}</h2>
      <p class="text-muted mb-6">Be the first service provider to list here and get discovered by local customers.</p>
      <a href="/post-your-ad" class="btn-primary">Post Your Free Ad</a>
    </section>
  )}

  <!-- Nearby Areas (Internal Linking for SEO) -->
  <section class="mb-8">
    <h2 class="text-lg font-bold text-ink mb-3">Nearby Areas in {region.name}</h2>
    <div class="city-grid bg-surface border border-line rounded-lg p-4">
      {nearbyLocalities.map((loc) => (
        <a href={`/${region.slug}/${loc.slug}/`}>
          {loc.name}
        </a>
      ))}
      <a href={`/${region.slug}/`} class="font-bold text-brand-dark">
        All {region.name} areas →
      </a>
    </div>
  </section>

  <!-- Localized FAQ -->
  <section class="mb-8">
    <h2 class="text-lg font-bold text-ink mb-4">FAQs — {locality.name}, {region.name}</h2>
    <div class="space-y-2">
      {faqItems.map((faq) => (
        <details class="card p-4 group">
          <summary class="cursor-pointer font-semibold text-ink list-none flex items-center justify-between">
            {faq.question}
            <span class="text-brand text-xl font-bold transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="text-muted text-sm mt-3 leading-relaxed">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
