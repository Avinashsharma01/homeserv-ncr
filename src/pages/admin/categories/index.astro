---
/**
 * /admin/categories/index.astro — Categories Management
 */
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { categories } from "../../../data/categories";
import { FolderTree, Plus, Pencil, Trash2 } from "lucide-astro";
import CategoryIcon from "../../../components/CategoryIcon.astro";
---

<AdminLayout title="Manage Categories" activeNav="categories">
  <!-- Add New Category -->
  <div class="admin-card">
    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem;">
      <Plus size={20} class="text-brand" />
      <h2 style="margin:0;">Add New Category</h2>
    </div>
    <form id="add-cat-form" style="display:grid;grid-template-columns:60px 1fr 2fr auto;gap:0.75rem;align-items:end;">
      <div>
        <label class="form-label" for="cat-icon">Icon</label>
        <input class="admin-input" id="cat-icon" placeholder="Wrench" maxlength="20" style="text-align:center;font-size:0.875rem;" />
      </div>
      <div>
        <label class="form-label" for="cat-name">Category Name</label>
        <input class="admin-input" id="cat-name" required placeholder="e.g., CCTV Installation" />
      </div>
      <div>
        <label class="form-label" for="cat-desc">Description</label>
        <input class="admin-input" id="cat-desc" placeholder="Brief description for SEO..." />
      </div>
      <button type="submit" class="admin-btn admin-btn-primary" style="height:38px;display:inline-flex;align-items:center;gap:0.25rem;">
        <Plus size={16} /> Add
      </button>
    </form>
  </div>

  <!-- Categories Table -->
  <div class="admin-card">
    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem;">
      <FolderTree size={20} class="text-brand" />
      <h2 style="margin:0;">All Categories ({categories.length})</h2>
    </div>
    <div style="overflow-x:auto;">
      <table class="admin-table">
        <thead>
          <tr>
            <th style="width:60px;">Icon</th>
            <th>Name</th>
            <th>Slug</th>
            <th>Description</th>
            <th>Keywords</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {categories.map((cat) => (
            <tr>
              <td style="text-align:center;">
                <div style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;background:#f0fdfa;color:#0d9488;">
                  <CategoryIcon category={cat.slug} size={18} />
                </div>
              </td>
              <td style="font-weight:600;">{cat.name}</td>
              <td><code style="font-size:0.75rem;background:#f1f5f9;padding:0.125rem 0.375rem;border-radius:0.25rem;">{cat.slug}</code></td>
              <td style="font-size:0.8125rem;color:#64748b;max-width:250px;">{cat.description.slice(0, 80)}…</td>
              <td>
                <div style="display:flex;flex-wrap:wrap;gap:0.25rem;">
                  {cat.keywords.slice(0, 3).map((kw) => (
                    <span style="font-size:0.6875rem;background:#f0fdfa;color:#0f766e;padding:0.125rem 0.375rem;border-radius:0.25rem;">{kw}</span>
                  ))}
                  {cat.keywords.length > 3 && (
                    <span style="font-size:0.6875rem;color:#94a3b8;">+{cat.keywords.length - 3}</span>
                  )}
                </div>
              </td>
              <td>
                <div class="admin-actions">
                  <button class="admin-btn admin-btn-secondary admin-btn-sm" title="Edit" style="display:inline-flex;align-items:center;justify-content:center;">
                    <Pencil size={13} />
                  </button>
                  <button class="admin-btn admin-btn-danger admin-btn-sm" title="Delete" style="display:inline-flex;align-items:center;justify-content:center;">
                    <Trash2 size={13} />
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  if (sessionStorage.getItem('admin_auth') !== 'true') {
    window.location.href = '/admin/login';
  }

  document.getElementById('add-cat-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('cat-name') as HTMLInputElement).value;
    alert(`Category "${name}" added successfully!\n\nIn production, this writes to Supabase and triggers a rebuild.`);
  });
</script>
