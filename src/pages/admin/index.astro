---
/**
 * /admin/index.astro — Admin Dashboard (Overview)
 * Stats cards + recent listings table + quick actions
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import { regions } from "../../data/regions";
import { categories } from "../../data/categories";
import { listings } from "../../data/listings";
import {
  ListChecks,
  BadgeCheck,
  Star,
  MapPin,
  Building2,
  FolderTree,
  Plus,
  Search,
  ExternalLink,
  Pencil,
  Trash2,
  FileText,
  Zap,
} from "lucide-astro";

const totalListings = listings.length;
const verifiedListings = listings.filter((l) => l.verified).length;
const premiumListings = listings.filter((l) => l.premium).length;
const totalLocalities = regions.reduce((sum, r) => sum + r.localities.length, 0);
const totalRegions = regions.length;
const totalCategories = categories.length;
const recentListings = listings.slice(0, 5);
---

<AdminLayout title="Dashboard" activeNav="dashboard">
  <!-- Stats Grid -->
  <div class="stat-grid" style="margin-bottom:1.5rem;">
    <div class="stat-card">
      <div class="stat-icon" style="display:flex;align-items:center;justify-content:center;color:#0d9488;">
        <ListChecks size={24} />
      </div>
      <div class="stat-value">{totalListings}</div>
      <div class="stat-label">Total Listings</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="display:flex;align-items:center;justify-content:center;color:#10b981;">
        <BadgeCheck size={24} />
      </div>
      <div class="stat-value">{verifiedListings}</div>
      <div class="stat-label">Verified</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="display:flex;align-items:center;justify-content:center;color:#f59e0b;">
        <Star size={24} class="fill-amber-400 text-amber-500" />
      </div>
      <div class="stat-value">{premiumListings}</div>
      <div class="stat-label">Premium</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="display:flex;align-items:center;justify-content:center;color:#3b82f6;">
        <MapPin size={24} />
      </div>
      <div class="stat-value">{totalLocalities}</div>
      <div class="stat-label">Localities</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="display:flex;align-items:center;justify-content:center;color:#8b5cf6;">
        <Building2 size={24} />
      </div>
      <div class="stat-value">{totalRegions}</div>
      <div class="stat-label">Regions</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="display:flex;align-items:center;justify-content:center;color:#6366f1;">
        <FolderTree size={24} />
      </div>
      <div class="stat-value">{totalCategories}</div>
      <div class="stat-label">Categories</div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="admin-card">
    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem;">
      <Zap size={20} class="text-brand" />
      <h2 style="margin:0;">Quick Actions</h2>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:0.75rem;">
      <a href="/admin/listings/new/" class="admin-btn admin-btn-primary" style="display:inline-flex;align-items:center;gap:0.375rem;">
        <Plus size={16} /> Add New Listing
      </a>
      <a href="/admin/localities/" class="admin-btn admin-btn-secondary" style="display:inline-flex;align-items:center;gap:0.375rem;">
        <MapPin size={16} /> Manage Localities
      </a>
      <a href="/admin/seo/" class="admin-btn admin-btn-secondary" style="display:inline-flex;align-items:center;gap:0.375rem;">
        <Search size={16} /> SEO Overrides
      </a>
      <a href="/" target="_blank" class="admin-btn admin-btn-secondary" style="display:inline-flex;align-items:center;gap:0.375rem;">
        <ExternalLink size={16} /> View Public Site
      </a>
    </div>
  </div>

  <!-- Recent Listings Table -->
  <div class="admin-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
      <h2 style="margin:0;">Recent Listings</h2>
      <a href="/admin/listings/" class="admin-btn admin-btn-secondary admin-btn-sm">View All →</a>
    </div>

    <div style="overflow-x:auto;">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Provider</th>
            <th>Category</th>
            <th>Location</th>
            <th>Status</th>
            <th>Rating</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {recentListings.map((listing) => (
            <tr>
              <td style="font-weight:600;color:#0d9488;">#{listing.id}</td>
              <td>
                <div style="font-weight:600;">{listing.providerName}</div>
                <div style="font-size:0.75rem;color:#94a3b8;">{listing.title.slice(0, 40)}…</div>
              </td>
              <td style="text-transform:capitalize;">{listing.category.replace(/-/g, " ")}</td>
              <td style="text-transform:capitalize;">
                {listing.locality.replace(/-/g, " ")}, {listing.region.replace(/-/g, " ")}
              </td>
              <td>
                <div style="display:flex;gap:0.25rem;flex-wrap:wrap;">
                  {listing.verified && <span class="admin-badge admin-badge-green">Verified</span>}
                  {listing.premium && <span class="admin-badge admin-badge-yellow">Premium</span>}
                  {listing.available24x7 && <span class="admin-badge admin-badge-blue">24/7</span>}
                </div>
              </td>
              <td>
                <span style="display:inline-flex;align-items:center;gap:0.25rem;color:#f59e0b;">
                  <Star size={13} class="fill-amber-400 text-amber-500" /> {listing.rating}
                </span>
                <span style="color:#94a3b8;font-size:0.75rem;">({listing.reviewCount})</span>
              </td>
              <td>
                <div class="admin-actions">
                  <a href={`/admin/listings/edit/?id=${listing.id}`} class="admin-btn admin-btn-secondary admin-btn-sm" style="display:inline-flex;align-items:center;gap:0.25rem;">
                    <Pencil size={13} /> Edit
                  </a>
                  <button class="admin-btn admin-btn-danger admin-btn-sm" title="Delete" data-delete-id={listing.id} style="display:inline-flex;align-items:center;justify-content:center;">
                    <Trash2 size={13} />
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pages Generated Info -->
  <div class="admin-card">
    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem;">
      <FileText size={20} class="text-brand" />
      <h2 style="margin:0;">Generated Pages Summary</h2>
    </div>
    <div style="overflow-x:auto;">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Region</th>
            <th>State</th>
            <th>Localities</th>
            <th>Pages Generated</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          {regions.map((region) => (
            <tr>
              <td style="font-weight:600;">{region.name}</td>
              <td>{region.state}</td>
              <td>{region.localities.length}</td>
              <td>
                <span class="admin-badge admin-badge-green">{region.localities.length + 1} pages</span>
              </td>
              <td>
                <a href={`/${region.slug}/`} target="_blank" class="admin-btn admin-btn-secondary admin-btn-sm" style="display:inline-flex;align-items:center;gap:0.25rem;">
                  <ExternalLink size={13} /> View
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:1rem;font-size:0.8125rem;color:#64748b;">
      Total: <strong>{totalLocalities + totalRegions + totalListings + 2} static HTML pages</strong> pre-rendered at build time.
    </p>
  </div>
</AdminLayout>

<script>
  // Auth guard — redirect to login if not authenticated
  if (sessionStorage.getItem('admin_auth') !== 'true') {
    window.location.href = '/admin/login';
  }

  // Delete action
  document.querySelectorAll('[data-delete-id]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = (btn as HTMLElement).dataset.deleteId;
      if (confirm(`Delete listing #${id}?`)) {
        btn.closest('tr')?.remove();
        alert(`Listing #${id} removed from dashboard view.`);
      }
    });
  });
</script>
