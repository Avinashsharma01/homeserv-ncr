---
/**
 * /admin/listings/edit/index.astro — Edit Listing Form
 */
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { categories } from "../../../../data/categories";
import { regions } from "../../../../data/regions";
import { listings } from "../../../../data/listings";
import { ArrowLeft, Pencil, Save, BadgeCheck, Star, AlertTriangle } from "lucide-astro";
---

<AdminLayout title="Edit Listing" activeNav="listings">
  <div style="max-width:720px;">
    <!-- Back link -->
    <a href="/admin/listings/" style="font-size:0.8125rem;color:#0d9488;text-decoration:none;display:inline-flex;align-items:center;gap:0.375rem;margin-bottom:1rem;font-weight:500;">
      <ArrowLeft size={14} /> Back to Listings
    </a>

    <div class="admin-card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <Pencil size={20} class="text-brand" />
          <h2 style="margin:0;">Edit Listing <span id="display-listing-id" style="color:#0d9488;font-size:1.125rem;"></span></h2>
        </div>
        <span id="edit-status-badge" class="admin-badge admin-badge-blue">Loading...</span>
      </div>

      <div id="not-found-msg" class="hidden p-4 bg-red-50 text-red-800 rounded-lg text-sm mb-4" style="display:flex;align-items:center;gap:0.5rem;">
        <AlertTriangle size={16} class="text-red-600 shrink-0" />
        <span>Listing not found. Please verify the ID or return to the listings list.</span>
      </div>

      <form id="edit-listing-form">
        <!-- Hidden ID -->
        <input type="hidden" id="listingId" name="id" />

        <!-- Provider Name -->
        <div class="form-group">
          <label class="form-label" for="providerName">Provider / Business Name *</label>
          <input class="admin-input" type="text" id="providerName" name="providerName" required placeholder="e.g., Rajesh Kumar Plumbing" />
        </div>

        <!-- Title -->
        <div class="form-group">
          <label class="form-label" for="title">Listing Title *</label>
          <input class="admin-input" type="text" id="title" name="title" required placeholder="e.g., Expert Plumber in Connaught Place, Delhi" />
          <p class="form-hint">Keep under 60 characters for best SEO</p>
        </div>

        <!-- Category & Region -->
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="category">Service Category *</label>
            <select class="admin-select" id="category" name="category" required>
              <option value="">Select category</option>
              {categories.map((cat) => (
                <option value={cat.slug}>{cat.icon} {cat.name}</option>
              ))}
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="region">Region *</label>
            <select class="admin-select" id="region" name="region" required>
              <option value="">Select region</option>
              {regions.map((r) => (
                <option value={r.slug}>{r.name}, {r.state}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Locality (Dynamic based on region) -->
        <div class="form-group">
          <label class="form-label" for="locality">Locality *</label>
          <select class="admin-select" id="locality" name="locality" required>
            <option value="">Select region first</option>
          </select>
        </div>

        <!-- Description -->
        <div class="form-group">
          <label class="form-label" for="description">Description *</label>
          <textarea class="admin-textarea" id="description" name="description" required rows="4" placeholder="Describe services, expertise, and areas covered..."></textarea>
          <p class="form-hint">Include service details, experience, and specializations for better SEO</p>
        </div>

        <!-- Phone & WhatsApp -->
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="phone">Phone Number *</label>
            <input class="admin-input" type="tel" id="phone" name="phone" required placeholder="+91 98765 43210" />
          </div>
          <div class="form-group">
            <label class="form-label" for="whatsapp">WhatsApp Number</label>
            <input class="admin-input" type="tel" id="whatsapp" name="whatsapp" placeholder="Same as phone if blank" />
          </div>
        </div>

        <!-- Price & Experience -->
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="price">Price Range</label>
            <input class="admin-input" type="text" id="price" name="price" placeholder="e.g., ₹300 - ₹1,500" />
          </div>
          <div class="form-group">
            <label class="form-label" for="experience">Experience</label>
            <input class="admin-input" type="text" id="experience" name="experience" placeholder="e.g., 10 years" />
          </div>
        </div>

        <!-- Tags -->
        <div class="form-group">
          <label class="form-label" for="tags">Tags / Specializations</label>
          <input class="admin-input" type="text" id="tags" name="tags" placeholder="pipe repair, leak repair, bathroom (comma separated)" />
          <p class="form-hint">Comma-separated keywords to help with search and SEO</p>
        </div>

        <!-- Toggles -->
        <div class="admin-card" style="background:#f8fafc;border:1px solid #e2e8f0;margin-bottom:1rem;">
          <h2 style="font-size:0.875rem;margin-bottom:0.75rem;">Status Flags</h2>
          <div style="display:flex;flex-wrap:wrap;gap:1.5rem;">
            <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;">
              <input type="checkbox" name="verified" id="verified" />
              <span class="admin-badge admin-badge-green" style="display:inline-flex;align-items:center;gap:0.25rem;">
                <BadgeCheck size={12} /> Verified
              </span>
            </label>
            <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;">
              <input type="checkbox" name="premium" id="premium" />
              <span class="admin-badge admin-badge-yellow" style="display:inline-flex;align-items:center;gap:0.25rem;">
                <Star size={12} class="fill-amber-400 text-amber-500" /> Premium
              </span>
            </label>
            <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;">
              <input type="checkbox" name="available24x7" id="available24x7" />
              <span class="admin-badge admin-badge-blue">24/7 Available</span>
            </label>
          </div>
        </div>

        <!-- Submit -->
        <div style="display:flex;gap:0.75rem;margin-top:1.5rem;">
          <button type="submit" class="admin-btn admin-btn-primary" style="padding:0.625rem 1.5rem;display:inline-flex;align-items:center;gap:0.5rem;">
            <Save size={16} /> Update Listing
          </button>
          <a href="/admin/listings/" class="admin-btn admin-btn-secondary" style="padding:0.625rem 1.5rem;">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ initialListings: listings, regionsData: regions }}>
  // Auth guard
  if (sessionStorage.getItem('admin_auth') !== 'true') {
    window.location.href = '/admin/login';
  }

  const params = new URLSearchParams(window.location.search);
  const targetId = params.get('id');

  const regionSelect = document.getElementById('region');
  const localitySelect = document.getElementById('locality');
  const form = document.getElementById('edit-listing-form');
  const notFoundEl = document.getElementById('not-found-msg');
  const idDisplay = document.getElementById('display-listing-id');
  const badge = document.getElementById('edit-status-badge');

  function updateLocalities(regionSlug, selectedLocality = '') {
    if (!localitySelect) return;
    const reg = regionsData.find((r) => r.slug === regionSlug);
    localitySelect.innerHTML = '<option value="">Select locality</option>';
    if (reg && reg.localities) {
      reg.localities.forEach((loc) => {
        const opt = document.createElement('option');
        opt.value = loc.slug;
        opt.textContent = loc.name;
        if (loc.slug === selectedLocality) opt.selected = true;
        localitySelect.appendChild(opt);
      });
    }
  }

  regionSelect?.addEventListener('change', () => {
    updateLocalities(regionSelect.value);
  });

  // Find listing by ID from initial seed data or local storage
  let currentListing = initialListings.find((l) => l.id === targetId);

  // Also check local pending listings
  if (!currentListing) {
    try {
      const pending = JSON.parse(localStorage.getItem('pending_listings') || '[]');
      currentListing = pending.find((l) => l.id === targetId);
    } catch (_) {}
  }

  if (currentListing) {
    if (idDisplay) idDisplay.textContent = `#${currentListing.id}`;
    if (badge) {
      badge.textContent = currentListing.verified ? 'Verified Active' : 'Active';
      badge.className = 'admin-badge admin-badge-green';
    }

    (document.getElementById('listingId')).value = currentListing.id;
    (document.getElementById('providerName')).value = currentListing.providerName || '';
    (document.getElementById('title')).value = currentListing.title || '';
    (document.getElementById('category')).value = currentListing.category || '';
    (document.getElementById('region')).value = currentListing.region || '';
    
    updateLocalities(currentListing.region, currentListing.locality);

    (document.getElementById('description')).value = currentListing.description || '';
    (document.getElementById('phone')).value = currentListing.phone || '';
    (document.getElementById('whatsapp')).value = currentListing.whatsapp || '';
    (document.getElementById('price')).value = currentListing.price || '';
    (document.getElementById('experience')).value = currentListing.experience || '';
    (document.getElementById('tags')).value = Array.isArray(currentListing.tags) ? currentListing.tags.join(', ') : (currentListing.tags || '');

    (document.getElementById('verified')).checked = !!currentListing.verified;
    (document.getElementById('premium')).checked = !!currentListing.premium;
    (document.getElementById('available24x7')).checked = !!currentListing.available24x7;
  } else {
    if (notFoundEl) notFoundEl.classList.remove('hidden');
    if (badge) {
      badge.textContent = 'Not Found';
      badge.className = 'admin-badge admin-badge-red';
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert(`Listing #${targetId} updated successfully!\n\nIn production, this updates the Supabase record and triggers a static rebuild.`);
    window.location.href = '/admin/listings/';
  });
</script>
