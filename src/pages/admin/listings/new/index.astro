---
/**
 * /admin/listings/new/index.astro — Add New Listing form
 */
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { categories } from "../../../../data/categories";
import { regions } from "../../../../data/regions";
import { ArrowLeft, Save, Plus, BadgeCheck, Star } from "lucide-astro";
---

<AdminLayout title="Add New Listing" activeNav="listings">
  <div style="max-width:720px;">
    <!-- Back link -->
    <a href="/admin/listings/" style="font-size:0.8125rem;color:#0d9488;text-decoration:none;display:inline-flex;align-items:center;gap:0.375rem;margin-bottom:1rem;font-weight:500;">
      <ArrowLeft size={14} /> Back to Listings
    </a>

    <div class="admin-card">
      <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem;">
        <Plus size={20} class="text-brand" />
        <h2 style="margin:0;">Create New Listing</h2>
      </div>

      <form id="new-listing-form">
        <!-- Provider Name -->
        <div class="form-group">
          <label class="form-label" for="providerName">Provider / Business Name *</label>
          <input class="admin-input" type="text" id="providerName" name="providerName" required placeholder="e.g., Rajesh Kumar Plumbing" />
        </div>

        <!-- Title -->
        <div class="form-group">
          <label class="form-label" for="title">Listing Title *</label>
          <input class="admin-input" type="text" id="title" name="title" required placeholder="e.g., Expert Plumber in Connaught Place, Delhi" />
          <p class="form-hint">Keep under 60 characters for best SEO</p>
        </div>

        <!-- Category & Region -->
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="category">Service Category *</label>
            <select class="admin-select" id="category" name="category" required>
              <option value="">Select category</option>
              {categories.map((cat) => (
                <option value={cat.slug}>{cat.icon} {cat.name}</option>
              ))}
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="region">Region *</label>
            <select class="admin-select" id="region" name="region" required>
              <option value="">Select region</option>
              {regions.map((r) => (
                <option value={r.slug}>{r.name}, {r.state}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Locality (Dynamic based on region) -->
        <div class="form-group">
          <label class="form-label" for="locality">Locality *</label>
          <select class="admin-select" id="locality" name="locality" required>
            <option value="">Select region first</option>
          </select>
        </div>

        <!-- Description -->
        <div class="form-group">
          <label class="form-label" for="description">Description *</label>
          <textarea class="admin-textarea" id="description" name="description" required placeholder="Describe services, expertise, and areas covered..."></textarea>
          <p class="form-hint">Include service details, experience, and specializations for better SEO</p>
        </div>

        <!-- Phone & WhatsApp -->
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="phone">Phone Number *</label>
            <input class="admin-input" type="tel" id="phone" name="phone" required placeholder="+91 98765 43210" />
          </div>
          <div class="form-group">
            <label class="form-label" for="whatsapp">WhatsApp Number</label>
            <input class="admin-input" type="tel" id="whatsapp" name="whatsapp" placeholder="Same as phone if blank" />
          </div>
        </div>

        <!-- Price & Experience -->
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="price">Price Range</label>
            <input class="admin-input" type="text" id="price" name="price" placeholder="e.g., ₹300 - ₹1,500" />
          </div>
          <div class="form-group">
            <label class="form-label" for="experience">Experience</label>
            <input class="admin-input" type="text" id="experience" name="experience" placeholder="e.g., 10 years" />
          </div>
        </div>

        <!-- Tags -->
        <div class="form-group">
          <label class="form-label" for="tags">Tags / Specializations</label>
          <input class="admin-input" type="text" id="tags" name="tags" placeholder="pipe repair, leak repair, bathroom (comma separated)" />
          <p class="form-hint">Comma-separated keywords to help with search and SEO</p>
        </div>

        <!-- Toggles -->
        <div class="admin-card" style="background:#f8fafc;border:1px solid #e2e8f0;margin-bottom:1rem;">
          <h2 style="font-size:0.875rem;margin-bottom:0.75rem;">Status Flags</h2>
          <div style="display:flex;flex-wrap:wrap;gap:1.5rem;">
            <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;">
              <input type="checkbox" name="verified" id="verified" />
              <span class="admin-badge admin-badge-green" style="display:inline-flex;align-items:center;gap:0.25rem;">
                <BadgeCheck size={12} /> Verified
              </span>
            </label>
            <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;">
              <input type="checkbox" name="premium" id="premium" />
              <span class="admin-badge admin-badge-yellow" style="display:inline-flex;align-items:center;gap:0.25rem;">
                <Star size={12} class="fill-amber-400 text-amber-500" /> Premium
              </span>
            </label>
            <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;">
              <input type="checkbox" name="available24x7" id="available24x7" />
              <span class="admin-badge admin-badge-blue">24/7 Available</span>
            </label>
          </div>
        </div>

        <!-- Submit -->
        <div style="display:flex;gap:0.75rem;margin-top:1.5rem;">
          <button type="submit" class="admin-btn admin-btn-primary" style="padding:0.625rem 1.5rem;display:inline-flex;align-items:center;gap:0.5rem;">
            <Save size={16} /> Save Listing
          </button>
          <a href="/admin/listings/" class="admin-btn admin-btn-secondary" style="padding:0.625rem 1.5rem;">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ regionsData: regions }}>
  // Auth guard
  if (sessionStorage.getItem('admin_auth') !== 'true') {
    window.location.href = '/admin/login';
  }

  const regionSelect = document.getElementById('region');
  const localitySelect = document.getElementById('locality');

  regionSelect?.addEventListener('change', () => {
    const reg = regionsData.find((r) => r.slug === regionSelect.value);
    localitySelect.innerHTML = '<option value="">Select locality</option>';
    if (reg && reg.localities) {
      reg.localities.forEach((loc) => {
        const opt = document.createElement('option');
        opt.value = loc.slug;
        opt.textContent = loc.name;
        localitySelect.appendChild(opt);
      });
    }
  });

  // Form submission (demo)
  document.getElementById('new-listing-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Listing saved successfully!\n\nIn production, this writes to Supabase and triggers a site rebuild on Cloudflare Pages.');
    window.location.href = '/admin/listings/';
  });
</script>
