---
/**
 * /contact.astro — Contact Us page
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SEOHead from "../components/SEOHead.astro";
import { Mail, Phone, MessageCircle, MapPin, CheckCircle2 } from "lucide-astro";
---

<BaseLayout>
  <SEOHead
    slot="head"
    title="Contact Us — HomeServ NCR Support & Inquiries"
    description="Get in touch with the HomeServ NCR support team. Reach us for listing assistance, partnerships, advertising inquiries, or directory support."
    canonicalPath="/contact"
    breadcrumbs={[
      { name: "Home", url: "/" },
      { name: "Contact Us", url: "/contact" },
    ]}
  />

  <nav aria-label="Breadcrumb" class="mb-6">
    <ol class="flex items-center gap-1 text-sm text-muted">
      <li><a href="/" class="hover:text-brand no-underline">Home</a></li>
      <li class="before:content-['/'] before:mx-1 font-medium text-ink">Contact Us</li>
    </ol>
  </nav>

  <div class="max-w-4xl mx-auto py-4">
    <div class="text-center mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink mb-3">Get in Touch With Us</h1>
      <p class="text-muted text-lg max-w-xl mx-auto">
        Have questions about listing your service, partnership inquiries, or general feedback? We're here to help.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <!-- Contact Cards -->
      <div class="card p-6 border border-line rounded-2xl bg-surface text-center flex flex-col items-center">
        <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand flex items-center justify-center mb-3">
          <Mail size={24} />
        </div>
        <h3 class="font-bold text-ink mb-1">Email Us</h3>
        <p class="text-xs text-muted mb-3">For business and general inquiries</p>
        <a href="mailto:support@homeservncr.com" class="text-brand font-semibold text-sm hover:underline">
          support@homeservncr.com
        </a>
      </div>

      <div class="card p-6 border border-line rounded-2xl bg-surface text-center flex flex-col items-center">
        <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand flex items-center justify-center mb-3">
          <Phone size={24} />
        </div>
        <h3 class="font-bold text-ink mb-1">Phone / WhatsApp</h3>
        <p class="text-xs text-muted mb-3">Mon - Sat: 9:00 AM - 7:00 PM</p>
        <a href="tel:+919876543210" class="text-brand font-semibold text-sm hover:underline block mb-2">
          +91 98765 43210
        </a>
        <a href="https://wa.me/919876543210" class="text-xs text-green-700 font-semibold hover:underline inline-flex items-center gap-1.5">
          <MessageCircle size={14} /> Chat on WhatsApp
        </a>
      </div>

      <div class="card p-6 border border-line rounded-2xl bg-surface text-center flex flex-col items-center">
        <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand flex items-center justify-center mb-3">
          <MapPin size={24} />
        </div>
        <h3 class="font-bold text-ink mb-1">Headquarters</h3>
        <p class="text-xs text-muted mb-3">Delhi NCR Operations</p>
        <p class="text-sm text-ink font-medium">Connaught Place, New Delhi, 110001</p>
      </div>
    </div>

    <!-- Contact Form -->
    <div class="card p-8 border border-line rounded-2xl bg-surface shadow-sm max-w-2xl mx-auto">
      <h2 class="text-xl font-bold text-ink mb-4 text-center">Send Us a Message</h2>

      <div id="contact-success" class="hidden p-4 mb-6 bg-green-50 border border-green-200 text-green-800 rounded-xl text-sm items-center justify-center gap-2">
        <CheckCircle2 size={18} class="text-green-600 shrink-0" />
        <span>Thank you! Your message has been received. Our team will get back to you within 24 hours.</span>
      </div>

      <form id="contact-form" class="space-y-4">
        <div>
          <label for="contact-name" class="block text-sm font-semibold text-ink mb-1">Full Name *</label>
          <input
            type="text"
            id="contact-name"
            required
            placeholder="Your name"
            class="w-full px-4 py-2.5 border border-line rounded-lg text-ink bg-surface focus:border-brand focus:ring-2 focus:ring-brand-100 outline-none transition"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="contact-email" class="block text-sm font-semibold text-ink mb-1">Email Address *</label>
            <input
              type="email"
              id="contact-email"
              required
              placeholder="you@example.com"
              class="w-full px-4 py-2.5 border border-line rounded-lg text-ink bg-surface focus:border-brand focus:ring-2 focus:ring-brand-100 outline-none transition"
            />
          </div>
          <div>
            <label for="contact-phone" class="block text-sm font-semibold text-ink mb-1">Phone Number</label>
            <input
              type="tel"
              id="contact-phone"
              placeholder="+91 98765 43210"
              class="w-full px-4 py-2.5 border border-line rounded-lg text-ink bg-surface focus:border-brand focus:ring-2 focus:ring-brand-100 outline-none transition"
            />
          </div>
        </div>

        <div>
          <label for="contact-subject" class="block text-sm font-semibold text-ink mb-1">Subject *</label>
          <select
            id="contact-subject"
            required
            class="w-full px-4 py-2.5 border border-line rounded-lg text-ink bg-surface focus:border-brand focus:ring-2 focus:ring-brand-100 outline-none transition"
          >
            <option value="listing">Listing Support & Verification</option>
            <option value="advertising">Advertising / Premium Listing</option>
            <option value="feedback">Feedback or Complaint</option>
            <option value="other">Other Inquiry</option>
          </select>
        </div>

        <div>
          <label for="contact-message" class="block text-sm font-semibold text-ink mb-1">Message *</label>
          <textarea
            id="contact-message"
            required
            rows="4"
            placeholder="How can we help you?"
            class="w-full px-4 py-2.5 border border-line rounded-lg text-ink bg-surface focus:border-brand focus:ring-2 focus:ring-brand-100 outline-none transition resize-y"
          ></textarea>
        </div>

        <button type="submit" class="btn-primary w-full py-3! font-bold text-base">
          Send Message
        </button>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement;
  const successBox = document.getElementById('contact-success');

  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (successBox) {
      successBox.classList.remove('hidden');
    }
    contactForm.reset();
  });
</script>
