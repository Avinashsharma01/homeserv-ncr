---
/**
 * Post Your Ad page — Lead capture for service providers
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SEOHead from "../components/SEOHead.astro";
import { regions } from "../data/regions";
import { categories } from "../data/categories";
import { CheckCircle2, Send } from "lucide-astro";
---

<BaseLayout>
  <SEOHead
    slot="head"
    title="Post Your Free Ad — List Your Home Service on HomeServ NCR"
    description="Post a free listing for your home service business in Delhi NCR. Reach thousands of local customers searching for plumbers, electricians, AC repair, and more."
    canonicalPath="/post-your-ad"
    breadcrumbs={[
      { name: "Home", url: "/" },
      { name: "Post Your Ad", url: "/post-your-ad" },
    ]}
  />

  <nav aria-label="Breadcrumb" class="mb-6">
    <ol class="flex items-center gap-1 text-sm text-muted">
      <li><a href="/" class="hover:text-brand no-underline">Home</a></li>
      <li class="before:content-['/'] before:mx-1 font-medium text-ink">Post Your Ad</li>
    </ol>
  </nav>

  <div class="max-w-2xl mx-auto">
    <h1 class="text-3xl font-extrabold text-ink mb-3">Post Your Free Ad</h1>
    <p class="text-muted text-lg mb-8">
      List your home service business and get discovered by thousands of local customers across Delhi-NCR. It's 100% free.
    </p>

    <!-- Success Feedback Container (Initially Hidden) -->
    <div id="ad-success-box" class="hidden p-6 mb-8 bg-green-50 border border-green-200 rounded-2xl text-center">
      <div class="w-14 h-14 mx-auto rounded-full bg-green-100 text-green-700 flex items-center justify-center mb-3">
        <CheckCircle2 size={32} />
      </div>
      <h2 class="text-xl font-bold text-green-900 mb-2">Listing Submitted Successfully!</h2>
      <p class="text-sm text-green-800 leading-relaxed max-w-md mx-auto mb-4">
        Thank you for listing your services on HomeServ NCR. Our moderation team will verify your phone and WhatsApp numbers and make your listing live.
      </p>
      <div class="flex justify-center gap-3">
        <a href="/" class="btn-primary py-2.5! px-5! text-sm">
          Return to Homepage
        </a>
        <button id="submit-another-btn" type="button" class="px-5 py-2.5 bg-surface border border-line rounded-lg text-sm font-semibold text-ink hover:border-brand transition">
          Post Another Ad
        </button>
      </div>
    </div>

    <form id="post-ad-form" class="space-y-6">
      <!-- Service Category -->
      <div>
        <label for="category" class="block text-sm font-semibold text-ink mb-1">Service Category *</label>
        <select id="category" name="category" required class="w-full px-4 py-3 border border-line rounded-lg text-ink bg-surface focus:border-brand focus:ring-2 focus:ring-brand-100 outline-none transition">
          <option value="">Select your service</option>
          {categories.map((cat) => (
            <option value={cat.slug}>{cat.name}</option>
          ))}
        </select>
      </div>

      <!-- Region & Locality Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="region" class="block text-sm font-semibold text-ink mb-1">City / Region *</label>
          <select id="region" name="region" required class="w-full px-4 py-3 border border-line rounded-lg text-ink bg-surface focus:border-brand focus:ring-2 focus:ring-brand-100 outline-none transition">
            <option value="">Select your city</option>
            {regions.map((r) => (
              <option value={r.slug}>{r.name}, {r.state}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="locality" class="block text-sm font-semibold text-ink mb-1">Locality / Area *</label>
          <select id="locality" name="locality" required class="w-full px-4 py-3 border border-line rounded-lg text-ink bg-surface focus:border-brand focus:ring-2 focus:ring-brand-100 outline-none transition">
            <option value="">Select city first</option>
          </select>
        </div>
      </div>

      <!-- Business Name -->
      <div>
        <label for="business-name" class="block text-sm font-semibold text-ink mb-1">Business / Provider Name *</label>
        <input type="text" id="business-name" name="businessName" required placeholder="e.g., Rajesh Kumar Plumbing"
          class="w-full px-4 py-3 border border-line rounded-lg text-ink bg-surface focus:border-brand focus:ring-2 focus:ring-brand-100 outline-none transition" />
      </div>

      <!-- Phone -->
      <div>
        <label for="phone" class="block text-sm font-semibold text-ink mb-1">Phone Number *</label>
        <input type="tel" id="phone" name="phone" required placeholder="+91 98765 43210"
          class="w-full px-4 py-3 border border-line rounded-lg text-ink bg-surface focus:border-brand focus:ring-2 focus:ring-brand-100 outline-none transition" />
      </div>

      <!-- WhatsApp -->
      <div>
        <label for="whatsapp" class="block text-sm font-semibold text-ink mb-1">WhatsApp Number</label>
        <input type="tel" id="whatsapp" name="whatsapp" placeholder="Same as phone if same"
          class="w-full px-4 py-3 border border-line rounded-lg text-ink bg-surface focus:border-brand focus:ring-2 focus:ring-brand-100 outline-none transition" />
      </div>

      <!-- Description -->
      <div>
        <label for="description" class="block text-sm font-semibold text-ink mb-1">Description *</label>
        <textarea id="description" name="description" required rows="4" placeholder="Describe your services, experience, and areas served..."
          class="w-full px-4 py-3 border border-line rounded-lg text-ink bg-surface focus:border-brand focus:ring-2 focus:ring-brand-100 outline-none transition resize-y"></textarea>
      </div>

      <!-- Price Range & Experience -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="price" class="block text-sm font-semibold text-ink mb-1">Price Range</label>
          <input type="text" id="price" name="price" placeholder="e.g., ₹300 - ₹1,500"
            class="w-full px-4 py-3 border border-line rounded-lg text-ink bg-surface focus:border-brand focus:ring-2 focus:ring-brand-100 outline-none transition" />
        </div>

        <div>
          <label for="experience" class="block text-sm font-semibold text-ink mb-1">Years of Experience</label>
          <input type="text" id="experience" name="experience" placeholder="e.g., 10 years"
            class="w-full px-4 py-3 border border-line rounded-lg text-ink bg-surface focus:border-brand focus:ring-2 focus:ring-brand-100 outline-none transition" />
        </div>
      </div>

      <!-- Submit -->
      <button type="submit" id="submit-btn" class="btn-primary w-full text-lg py-4! font-bold flex items-center justify-center gap-2">
        <Send size={20} /> Post My Free Ad
      </button>

      <p class="text-xs text-muted text-center">
        By posting, you agree to our <a href="/terms" class="text-brand">Terms of Service</a> and <a href="/privacy-policy" class="text-brand">Privacy Policy</a>.
        Your listing will be reviewed before going live.
      </p>
    </form>
  </div>
</BaseLayout>

<script>
  import { regions } from "../data/regions";

  const regionSelect = document.getElementById('region') as HTMLSelectElement;
  const localitySelect = document.getElementById('locality') as HTMLSelectElement;
  const form = document.getElementById('post-ad-form') as HTMLFormElement;
  const successBox = document.getElementById('ad-success-box');
  const submitAnotherBtn = document.getElementById('submit-another-btn');

  // Populate localities dynamically when region changes
  regionSelect?.addEventListener('change', () => {
    const selectedRegion = regions.find((r) => r.slug === regionSelect.value);
    if (!localitySelect) return;

    localitySelect.innerHTML = '<option value="">Select locality</option>';
    if (selectedRegion && selectedRegion.localities) {
      selectedRegion.localities.forEach((loc) => {
        const opt = document.createElement('option');
        opt.value = loc.slug;
        opt.textContent = loc.name;
        localitySelect.appendChild(opt);
      });
    }
  });

  // Client-side intercept to save and show confirmation
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const newSubmission = {
      id: Date.now().toString(),
      category: formData.get('category'),
      region: formData.get('region'),
      locality: formData.get('locality'),
      providerName: formData.get('businessName'),
      phone: formData.get('phone'),
      whatsapp: formData.get('whatsapp') || formData.get('phone'),
      description: formData.get('description'),
      price: formData.get('price') || 'On Request',
      experience: formData.get('experience') || 'Experienced',
      status: 'pending',
      createdAt: new Date().toISOString().split('T')[0],
    };

    // Store in localStorage for admin review
    try {
      const existing = JSON.parse(localStorage.getItem('pending_listings') || '[]');
      existing.unshift(newSubmission);
      localStorage.setItem('pending_listings', JSON.stringify(existing));
    } catch (err) {
      console.warn('Could not store to localStorage', err);
    }

    form.classList.add('hidden');
    successBox?.classList.remove('hidden');
  });

  submitAnotherBtn?.addEventListener('click', () => {
    form.reset();
    form.classList.remove('hidden');
    successBox?.classList.add('hidden');
  });
</script>
