---
/**
 * /search.astro — Search & Filter Results Page
 * Allows searching by Category, Region, and Keyword
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SEOHead from "../components/SEOHead.astro";
import ListingCard from "../components/ListingCard.astro";
import { regions } from "../data/regions";
import { categories, getCategoryBySlug } from "../data/categories";
import { listings } from "../data/listings";
import { Search, PlusCircle } from "lucide-astro";
---

<BaseLayout>
  <SEOHead
    slot="head"
    title="Search Home Services in Delhi NCR — Verified Plumbers, Electricians, AC Repair | HomeServ NCR"
    description="Search verified home service providers across Delhi, Gurgaon, Noida, Faridabad, Ghaziabad, and Greater Noida. Find trusted professionals near you."
    canonicalPath="/search"
    breadcrumbs={[
      { name: "Home", url: "/" },
      { name: "Search", url: "/search" },
    ]}
  />

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="mb-6">
    <ol class="flex items-center gap-1 text-sm text-muted">
      <li><a href="/" class="hover:text-brand no-underline">Home</a></li>
      <li class="before:content-['/'] before:mx-1 font-medium text-ink">
        Search
      </li>
    </ol>
  </nav>

  <!-- Search Header & Filter Bar -->
  <section class="mb-8">
    <h1 class="text-3xl font-extrabold text-ink mb-2">
      Find Verified Home Services
    </h1>
    <p class="text-muted mb-6">
      Filter by service category, city, or search by keyword.
    </p>

    <div class="search-bar p-5! rounded-2xl shadow-lg">
      <form
        id="search-filter-form"
        class="grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-4 items-end"
      >
        <!-- Keyword -->
        <div class="sm:col-span-4">
          <label
            for="filter-q"
            class="block text-xs font-semibold text-white/90 mb-1.5 uppercase tracking-wider"
            >Keywords</label
          >
          <input
            type="text"
            id="filter-q"
            name="q"
            placeholder="e.g., leak, wiring, AC install..."
            class="w-full px-3.5 py-2.5 rounded-lg bg-surface text-ink text-sm outline-none border border-transparent focus:border-brand"
          />
        </div>

        <!-- Category -->
        <div class="sm:col-span-3">
          <label
            for="filter-category"
            class="block text-xs font-semibold text-white/90 mb-1.5 uppercase tracking-wider"
            >Service Category</label
          >
          <select
            id="filter-category"
            name="category"
            class="w-full px-3.5 py-2.5 rounded-lg bg-surface text-ink text-sm outline-none border border-transparent focus:border-brand"
          >
            <option value="">All Services</option>
            {
              categories.map((cat) => (
                <option value={cat.slug}>{cat.name}</option>
              ))
            }
          </select>
        </div>

        <!-- Region -->
        <div class="sm:col-span-3">
          <label
            for="filter-region"
            class="block text-xs font-semibold text-white/90 mb-1.5 uppercase tracking-wider"
            >City / Region</label
          >
          <select
            id="filter-region"
            name="region"
            class="w-full px-3.5 py-2.5 rounded-lg bg-surface text-ink text-sm outline-none border border-transparent focus:border-brand"
          >
            <option value="">All Delhi-NCR</option>
            {regions.map((r) => <option value={r.slug}>{r.name}</option>)}
          </select>
        </div>

        <!-- Reset Button -->
        <div class="sm:col-span-2">
          <button
            type="button"
            id="reset-filter-btn"
            class="w-full py-2.5 px-3 bg-white/10 hover:bg-white/20 text-white rounded-lg text-sm font-semibold transition"
          >
            Clear Filters
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- Filter Status & Results Count -->
  <div class="flex items-center justify-between mb-6 pb-3 border-b border-line">
    <p class="text-sm text-muted" id="results-count">
      Showing <strong class="text-ink" id="visible-count"
        >{listings.length}</strong
      > verified provider(s)
    </p>
    <div class="flex items-center gap-2" id="active-filter-tags">
      <!-- Active filter badges injected via JS -->
    </div>
  </div>

  <!-- Listings Grid -->
  <div id="listings-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {
      listings.map((listing) => {
        const cat = getCategoryBySlug(listing.category);
        return (
          <div
            class="search-listing-item"
            data-category={listing.category}
            data-region={listing.region}
            data-locality={listing.locality}
            data-searchtext={`${listing.title} ${listing.providerName} ${listing.description} ${listing.tags.join(" ")} ${cat?.name || ""}`.toLowerCase()}
          >
            <ListingCard
              id={listing.id}
              slug={listing.slug}
              title={listing.title}
              category={listing.category}
              locality={listing.locality}
              region={listing.region}
              providerName={listing.providerName}
              description={listing.description}
              rating={listing.rating}
              reviewCount={listing.reviewCount}
              price={listing.price}
              experience={listing.experience}
              verified={listing.verified}
              premium={listing.premium}
              available24x7={listing.available24x7}
              phone={listing.phone}
              whatsapp={listing.whatsapp}
            />
          </div>
        );
      })
    }
  </div>

  <!-- Empty State (Hidden when results exist) -->
  <div
    id="empty-state"
    class="hidden text-center py-16 px-4 bg-surface rounded-2xl border border-line mt-4"
  >
    <div class="w-16 h-16 mx-auto rounded-full bg-gray-100 flex items-center justify-center text-gray-400 mb-4">
      <Search size={32} />
    </div>
    <h3 class="text-xl font-bold text-ink mb-2">No Service Providers Found</h3>
    <p class="text-muted max-w-md mx-auto mb-6">
      We couldn't find any listings matching your current filter criteria. Try
      expanding your search to all cities or clearing the keyword search.
    </p>
    <div class="flex flex-wrap gap-3 justify-center">
      <button id="empty-reset-btn" class="btn-primary py-2.5! px-5! text-sm">
        Clear All Filters
      </button>
      <a
        href="/post-your-ad"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-surface border border-line rounded-lg text-sm font-semibold text-ink hover:border-brand hover:text-brand transition"
      >
        <PlusCircle size={16} /> Post Your Listing Here
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  // Parse URL query parameters
  const params = new URLSearchParams(window.location.search);
  const initialCategory = params.get("category") || "";
  const initialRegion = params.get("region") || "";
  const initialQ = params.get("q") || "";

  const qInput = document.getElementById("filter-q") as HTMLInputElement;
  const categorySelect = document.getElementById(
    "filter-category",
  ) as HTMLSelectElement;
  const regionSelect = document.getElementById(
    "filter-region",
  ) as HTMLSelectElement;
  const resetBtn = document.getElementById("reset-filter-btn");
  const emptyResetBtn = document.getElementById("empty-reset-btn");
  const visibleCountEl = document.getElementById("visible-count");
  const emptyStateEl = document.getElementById("empty-state");
  const items = document.querySelectorAll<HTMLElement>(".search-listing-item");

  if (qInput) qInput.value = initialQ;
  if (categorySelect) categorySelect.value = initialCategory;
  if (regionSelect) regionSelect.value = initialRegion;

  function filterListings() {
    const q = (qInput?.value || "").toLowerCase().trim();
    const cat = categorySelect?.value || "";
    const reg = regionSelect?.value || "";

    let visibleCount = 0;

    items.forEach((item) => {
      const itemCat = item.dataset.category || "";
      const itemReg = item.dataset.region || "";
      const itemText = item.dataset.searchtext || "";

      let matches = true;

      if (cat && itemCat !== cat) matches = false;
      if (reg && itemReg !== reg) matches = false;
      if (q && !itemText.includes(q)) matches = false;

      if (matches) {
        item.style.display = "";
        visibleCount++;
      } else {
        item.style.display = "none";
      }
    });

    if (visibleCountEl) visibleCountEl.textContent = visibleCount.toString();

    if (emptyStateEl) {
      if (visibleCount === 0) {
        emptyStateEl.classList.remove("hidden");
      } else {
        emptyStateEl.classList.add("hidden");
      }
    }

    // Update browser URL query string without reloading
    const newParams = new URLSearchParams();
    if (cat) newParams.set("category", cat);
    if (reg) newParams.set("region", reg);
    if (q) newParams.set("q", q);

    const newUrl =
      window.location.pathname +
      (newParams.toString() ? `?${newParams.toString()}` : "");
    window.history.replaceState({}, "", newUrl);
  }

  qInput?.addEventListener("input", filterListings);
  categorySelect?.addEventListener("change", filterListings);
  regionSelect?.addEventListener("change", filterListings);

  function clearAll() {
    if (qInput) qInput.value = "";
    if (categorySelect) categorySelect.value = "";
    if (regionSelect) regionSelect.value = "";
    filterListings();
  }

  resetBtn?.addEventListener("click", clearAll);
  emptyResetBtn?.addEventListener("click", clearAll);

  // Run initial filter on page load
  filterListings();
</script>
